# Set these in the hosting environment. No keys are required for free local practice.
PORT=4173
APP_ORIGIN=http://localhost:4173
# Use a trusted Solana mainnet RPC supporting filtered getProgramAccounts.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# On Windows corporate networks, Node 24 can trust the operating system CA store.
# NODE_USE_SYSTEM_CA=1
